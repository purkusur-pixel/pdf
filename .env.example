# Alan adı / Domain (DNS A kaydı bu sunucuyu göstermeli / must point to this server)
DOMAIN=pdf.sporyazilimlari.com.tr
# Let's Encrypt hesabı için e-posta / e-mail for the Let's Encrypt account
ACME_EMAIL=admin@sporyazilimlari.com.tr

# --- Yalnızca sunucuda zaten Nginx/Apache varsa / only if Nginx/Apache already uses 80/443 ---
# Caddy SSL almaz, sadece yerelde HTTP sunar; mevcut proxy'ni 127.0.0.1:8080'e yönlendir.
# Caddy won't fetch certificates; point your existing proxy to 127.0.0.1:8080.
#DOMAIN=:80
#HTTP_PORT=127.0.0.1:8080
#HTTPS_PORT=127.0.0.1:8443
