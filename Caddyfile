# Caddy: siteyi sunar ve SSL sertifikasını otomatik alır/yeniler.
# Serves the site and obtains/renews the TLS certificate automatically.
{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	root * /srv

	# libs/*.js için hazır .br/.gz kullanılır / precompressed files for libs
	file_server {
		precompressed br gzip
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	@static path /libs/* /fonts/* /icons/*
	header @static Cache-Control "public, max-age=2592000"

	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"

	@webmanifest path /manifest.webmanifest
	header @webmanifest Content-Type "application/manifest+json"

	log {
		output discard
	}
}
